#!/usr/bin/env php
<?php

use PhpRepos\Git\Signals\GitHostDownloadProgress;
use PhpRepos\Git\Signals\SendingGitHttpRequest;
use PhpRepos\Git\Signals\HttpResponseReceived;
use PhpRepos\Logger\API\Config;
use PhpRepos\Logger\API\Logs;
use PhpRepos\Logger\API\Media;
use PhpRepos\Logger\Core\Data\Message;
use PhpRepos\Observer\API\Bus;
use PhpRepos\Observer\API\Signal;
use Phpkg\Infra\CLI;
use Phpkg\Infra\Files;
use PhpRepos\Console\Business\Finder;
use PhpRepos\Console\Business\Command;
use PhpRepos\Console\UI;
use PhpRepos\Console\Infra\Filesystem;

global $argv;

$entrypoint = 'phpkg';
$short_options = 'vhd';
$long_options = ['help', 'debug'];
$options = getopt($short_options, $long_options, $offset);
$wants_help = isset($options['h']) || isset($options['help']);
$inputs = array_slice($argv, $offset);

$verbosity_level = 0;
if (isset($options['v'])) {
    $verbosity_level = is_array($options['v']) ? count($options['v']) : 1;
}

$debug_mode = isset($options['d']) || isset($options['debug']);

$cli_logger = function (Message $message) {
    $context = json_encode($message->context);
    $format = <<<EOD
\e[34m[{$message->time->format('Y-m-d\TH:i:s.uP')}] \e[33m{$message->level}:\e[39m {$message->text} \e[34m{$context}
EOD;

    CLI\line($format);
};

Config\set_default_media(function (Message $message) use ($verbosity_level, $debug_mode, $cli_logger) {
    if ($debug_mode || $message->level !== 'DEBUG') {
        Media\file_lock(Files\realpath(__DIR__.'/Logs/phpkg.log'))($message);
    }

    if ($verbosity_level === 0 || $verbosity_level === 1) {
        return;
    }
    if ($verbosity_level === 2) {
        if ($message->level === 'DEBUG') return;
        $cli_logger($message);
        return;
    }

    $cli_logger($message);
});

Bus\subscribe(function (Signal $signal) use ($verbosity_level, $cli_logger) {
    Logs\info('A signal has been sent.', $signal->jsonSerialize(), Media\file_lock(Files\realpath(__DIR__ . '/Logs/console-signals.log')));

    if ($verbosity_level === 0) {
        return;
    }
    Logs\info("Signal $signal->title", $signal->details, $cli_logger);
});

Bus\subscribe(function (GitHostDownloadProgress $progress) use ($verbosity_level) {
    if ($verbosity_level > 0) return;
    $details = $progress->details;

    // Generate unique ID for this download (includes full hash)
    $id = sprintf(
        '%s/%s/%s@%s',
        $details['domain'],
        $details['owner'],
        $details['repo'],
        $details['hash']
    );
    
    // Generate GitHub commit URL for clickable link
    $url = null;
    if ($details['domain'] === 'github.com') {
        $url = sprintf(
            'https://github.com/%s/%s/commit/%s',
            $details['owner'],
            $details['repo'],
            $details['hash']
        );
    }
    
    CLI\download_progressbar(
        $id,
        $url,
        $details['downloaded'],
        $details['download_size'],
        $details['time']
    );
});

Bus\subscribe(function (SendingGitHttpRequest $plan) use ($verbosity_level) {
    if ($verbosity_level === 0) {
        CLI\show_spinner($plan->details['method'] . ': ' . $plan->details['url']);
    }
});
Bus\subscribe(function (HttpResponseReceived $event) use ($verbosity_level) {
    if ($verbosity_level === 0) {
        CLI\hide_spinner();
    }
});

$root = Filesystem\realpath(__DIR__ . DIRECTORY_SEPARATOR . 'Commands');
$outcome = Finder\path($root, 'Command.php');

if (!$outcome->success) CLI\error($outcome->message) && exit(1);

$command_handlers = $outcome->data['handlers'];

$outcome = Command\find($command_handlers, $inputs);

if (!$outcome->success) {
    if (!$wants_help) CLI\error($outcome->message);

    $outcome = Command\all($command_handlers);
    CLI\write(UI\short_help($outcome->data['commands'], $entrypoint)) && exit($wants_help ? 0 : 1);
}

$command = $outcome->data['name'];
$handler = $outcome->data['handler'];

$outcome = Command\describe($handler);
if (!$outcome->success) CLI\error($outcome->message) && exit(1);

$description = $outcome->data;

if ($wants_help)
    CLI\write(UI\long_help($description, $entrypoint, $command)) && exit(0);

$outcome = Command\run($command, $handler, $command_handlers, $inputs);

if (!$outcome->success)
    CLI\error($outcome->message)
    && CLI\write(UI\long_help($description, $entrypoint, $command))
    && exit($outcome->data['exit_code'] ?? 1);

exit($outcome->data['exit_code'] ?? 0);
